# 텍스트 파일은 저장소와 작업 폴더 모두 LF로 통일
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리 (아트, 폰트, 소리, 포장 결과)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.wav binary
*.exe binary
*.zip binary
